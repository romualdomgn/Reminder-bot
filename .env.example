# Telegram токен бота. Брать здесь - @BotFather
TELEGRAM_BOT_TOKEN=**********************

# Telegram ID админа бота. Брать здесь - @userinfobot
ADMIN_TELEGRAM_ID=**********************

# Telegram ID пользователей, у которых есть доступ к боту. Так же можно добавлять в самом боте
# Брать здесь - @userinfobot
USER_TELEGRAM_ID=**********************, **********************

# Смещение часовых поясов
TZ_OFFSET_HOURS=4

# open-source приложение и репозиторий
REPOSITORY=https://github.com/romualdomgn/Reminder-bot

# Cоздатель и администратор бота для обратной связи
TgUserName=@**********************

# Используется прокси для Telegram API
TELEGRAM_PROXY=socks5://127.0.0.1:49000


# Cloudflare token
CLOUDFLARE_TUNNEL_TOKEN=**********************

WEBAPP_URL=https://***********************
APP_UID=990
APP_GID=985