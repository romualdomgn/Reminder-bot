# Telegram токен бота. Брать здесь - @BotFather
TELEGRAM_BOT_TOKEN=**********************

# Telegram ID админа бота. Брать здесь - @userinfobot
ADMIN_TELEGRAM_ID=**********************

# Telegram ID пользователей, у которых есть доступ к боту. Так же можно добавлять в самом боте
# Брать здесь - @userinfobot
USER_TELEGRAM_ID=**********************, **********************

# Смещение часовых поясов по умолчанию
TZ_OFFSET_HOURS=5

# open-source приложение и репозиторий
REPOSITORY=https://github.com/romualdomgn/Reminder-bot

# Создатель и администратор бота для обратной связи
TgUserName=@**********************

# Прокси для Telegram API чат-бота (например, локальный Cloudflare WARP)
TELEGRAM_PROXY=socks5://127.0.0.1:49000

# Прокси для Mini App (direct — прямой выход, либо URL прокси доступного из контейнера)
WEBAPP_TELEGRAM_PROXY=direct

# Cloudflare Tunnel token и URL Mini App
CLOUDFLARE_TUNNEL_TOKEN=**********************
WEBAPP_URL=https://***********************

# UID/GID пользователя reminder_bot_user для совместной работы с SQLite WAL
APP_UID=990
APP_GID=985
