[Unit]
Description=Telegram Reminder Bot (Single-Message UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=reminder_bot_user
Group=reminder_bot_user
WorkingDirectory=/opt/reminder_bot
EnvironmentFile=/opt/reminder_bot/.env
Environment="MALLOC_ARENA_MAX=2"
ExecStart=/opt/reminder_bot/venv/bin/python /opt/reminder_bot/bot.py
Restart=always
RestartSec=5

# Дополнительная изоляция безопасности systemd
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/reminder_bot

[Install]
WantedBy=multi-user.target
